        "labelPadding": 8
      }
    },
    "y": {
      "field": "departures_people",
      "type": "quantitative",
      "title": "Migrant departures (people)",
      "scale": {
        "zero": true,
        "domain": [
          0,
          100000
        ]
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 6,
        "gridColor": "#c5d3e0",
        "domain": false,
        "tickSize": 0,
        "labelPadding": 8
