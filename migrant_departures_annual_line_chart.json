  "params": [
    {
      "name": "country_select",
      "select": {
        "type": "point",
        "fields": [
          "country_of_birth"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 2.8,
    "interpolate": "linear",
    "point": {
      "filled": true,
      "size": 20
    }
  },
